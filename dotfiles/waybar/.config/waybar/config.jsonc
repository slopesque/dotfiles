// -*- mode: jsonc -*-
[
    {
        "layer": "top",
        "position": "top",
        "height": 30,
        "modules-left": [
            "clock",
            "pulseaudio",
            "network",
            "bluetooth",
            "mpris",
            "custom/virtual-keyboard",
            "hyprland/language",
            "custom/locker"
        ],
        "modules-center": ["hyprland/workspaces"],
        "modules-right": [
            "custom/updates",
            "custom/notifications",
            "cpu",
            "memory",
            "temperature",
            "backlight",
            "battery"
        ],
        "mpris": {
            "format": "{player_icon}",
            "format-paused": "{status_icon}",
            "tooltip-format": "Listening on {player} ~\nNow on: {title} by {artist}\n{position}/{length}",
            "player-icons": {
                "default": "▶",
                "mpv": "🎵"
            },
            "status-icons": {
                "paused": "⏸",
                "stopped": "󰝛",
            },
            "truncate-hours": true,
            "interval": 1
        },
        "backlight": {
            "format": "{percent}% {icon}",
            "format-icons": [
                "🌑",
                "🌘",
                "🌗",
                "🌖",
                "🌕"
            ],
            "on-scroll-up": "brightnessctl set +1%",
            "on-scroll-down": "brightnessctl  set 1%-"
        },
        "battery": {
            "states": {
                "good": 70,
                "warning": 30,
                "critical": 15
            },
            "format": "{capacity}% {icon}",
            "format-full": "{capacity}% {icon}",
            "format-charging": "{capacity}% ",
            "format-plugged": "{capacity}% ",
            "format-alt": "{time} {icon}",
            "format-icons": [
                "",
                "",
                "",
                "",
                ""
            ],
            "events": {
                "on-discharging-critical": "notify-send 'Low battery' 'Quick, find a charger!' --app-name 'waybar' --urgency=critical",
            }
        },
        "battery#bat2": {
            "bat": "BAT2"
        },
        "bluetooth": {
            "format": "",
            "format-connected": "󰂱",
            "format-connected-battery": "󰂱 {device_battery_percentage}%",
            "format-on": "",
            "format-off": "󰂲",
            "format-disabled": "",
            "format-no-controller": "",
            "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
            "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
            "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
            "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
            "on-click": "kitty bluetoothctl",
        },
        "clock": {
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
            "format-alt": "{:%Y-%m-%d}"
        },
        "cpu": {
            "format": "{usage}% ",
            "tooltip": false,
            "on-click": "kitty btop"
        },
        "custom/focus-mode": {
            "format": "{text}",
            "tooltip-format": "{alt}",
            "return-type": "json",
            "exec": "~/.config/waybar/scripts/check-focus-mode-state.sh",
            "restart-interval": 1,
            "on-click": "~/.config/waybar/scripts/switch-focus-mode-state.sh"
        },
        "custom/locker": {
            "format": "{text}",
            "tooltip-format": "{alt}",
            "return-type": "json",
            "exec": "~/.config/waybar/scripts/check-locker-state.sh",
            "restart-interval": 1,
            "on-click": "~/.config/waybar/scripts/switch-locker-state.sh"
        },
        "custom/notifications": {
            "format": "{text} {icon}",
            "tooltip-format": "{alt}",
            "return-type": "json",
            "exec": "dunstctl count history | xargs printf '{ \"text\": \"%1$d \", \"alt\": \"%1$d hidden notification(s)\" }'",
            "on-click": "dunstctl history-pop",
            "on-click-right": "dunstctl close-all ; dunstctl history-clear",
            "restart-interval": 2
        },
        "custom/power": {
            "format": " ⏻ ",
            "tooltip": false,
            "menu": "on-click",
            "menu-file": "$HOME/.config/waybar/components/power_menu.xml",
            "menu-actions": {
                "lock": "hyprlock",
                "exit": "hyprctl dispatch hyprshutdown",
                "shutdown": "loginctl poweroff",
                "reboot": "loginctl reboot"
            }
        },
        "custom/updates": {
            "format": "{text} ",
            "tooltip-format": "{alt}",
            "escape": "true",
            "return-type": "json",
            "exec": "~/.config/waybar/scripts/check-updates.sh",
            "restart-interval": 150,
            "on-click": "~/.config/waybar/scripts/start-updates.sh"
        },
        "custom/virtual-keyboard": {
            "format": "󰌌",
            "return-type": "json",
            "exec": "~/.config/waybar/scripts/check-keyboard-state.sh",
            "restart-interval": 1,
            "on-click": "~/.config/waybar/scripts/toggle-keyboard.sh"
        },
        "hyprland/language": {
            "format-en": "en",
            "format-fr": "fr"
        },
        "memory": {
            "format": "{}% ",
            "on-click": "kitty btop"
        },
        "network": {
            "format": "{icon}",
            "format-icons": {
                "wifi": "󰖩",
                "ethernet": "󰈀",
                "linked": "󱛇",
                "disconnected": "󰤯",
                "disabled": "󰖪",
            },
            "format-alt": "{ifname}: {ipaddr}/{cidr}",
            "tooltip-format": "{essid} ({signalStrength}%)\n{ifname} via {gwaddr}\n {bandwidthUpBytes}\t {bandwidthDownBytes}",
            "on-click-right": "kitty nmtui"
        },
        "pulseaudio": {
            "format": "{volume}% {icon} {format_source}",
            "format-bluetooth": "{volume}% {icon} {format_source}",
            "format-bluetooth-muted": " {icon} {format_source}",
            "format-muted": " {format_source}",
            "format-source": "{volume}% ",
            "format-source-muted": "",
            "format-icons": {
                "headphone": "",
                "hands-free": "",
                "headset": "",
                "phone": "",
                "portable": "",
                "car": "",
                "default": [
                    "",
                    "",
                    ""
                ]
            },
            "scroll-step": 1,
            "on-click": "pavucontrol"
        },
        "temperature": {
            "critical-threshold": 80,
            "format": "{temperatureC}°C {icon}",
            "format-icons": [
                "",
                "",
                ""
            ],
            "on-click": "kitty btop"
        },
        "hyprland/workspaces": {
            "format": "{name}",
            "format-icons": {
                "1": "",
                "2": "",
                "3": "",
                "4": "",
                "5": "",
                "urgent": "",
                "focused": "",
                "default": ""
            },
            "disable-scroll": true
        }
    }
]
